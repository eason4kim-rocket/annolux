# Annolux API. Copy to .env on the deployment host; never commit .env.
ANNOLUX_ORIGIN=https://annolux.com
ANNOLUX_API_PUBLIC_URL=https://api.annolux.com
ANNOLUX_LISTEN_ADDR=0.0.0.0:8080
ANNOLUX_INDEX_PATH=/data/index.db
ANNOLUX_ACCOUNTS_PATH=/data/accounts.db
ANNOLUX_MAX_CONCURRENT_SEARCH=12

# Generate with: openssl rand -base64 48
ANNOLUX_ACCOUNT_HMAC_SECRET=

# OAuth. Both providers are required for the public launch.
ANNOLUX_GOOGLE_CLIENT_ID=
ANNOLUX_GOOGLE_CLIENT_SECRET=
ANNOLUX_GOOGLE_REDIRECT_URL=https://api.annolux.com/api/v1/auth/google/callback
ANNOLUX_GITHUB_CLIENT_ID=
ANNOLUX_GITHUB_CLIENT_SECRET=
ANNOLUX_GITHUB_REDIRECT_URL=https://api.annolux.com/api/v1/auth/github/callback

# Paddle Sandbox. Live requires BOTH freeze gates plus the seller-support gate.
ANNOLUX_PADDLE_ENVIRONMENT=sandbox
ANNOLUX_PADDLE_API_KEY=
ANNOLUX_PADDLE_CLIENT_TOKEN=
ANNOLUX_PADDLE_WEBHOOK_SECRET=
ANNOLUX_PADDLE_PRO_PRICE_ID=
ANNOLUX_PADDLE_SCALE_PRICE_ID=
ANNOLUX_TERMS_VERSION=2026-08-16
ANNOLUX_REFUND_VERSION=2026-08-16
ANNOLUX_PADDLE_LIVE_ENABLED=false
ANNOLUX_PADDLE_LIVE_APPROVED=false

# Compose pins. Use immutable sha256 image digests, never mutable tags.
# The private GHCR token never belongs here; feed it to the pull helper on stdin.
ANNOLUX_ENV_FILE=.env
ANNOLUX_API_CONTAINER_NAME=annolux-api
ANNOLUX_WEB_CONTAINER_NAME=annolux-web
ANNOLUX_TUNNEL_CONTAINER_NAME=annolux-tunnel
ANNOLUX_API_IMAGE=ghcr.io/eason4kim-rocket/annolux@sha256:REPLACE
ANNOLUX_WEB_IMAGE=ghcr.io/eason4kim-rocket/annolux@sha256:REPLACE
ANNOLUX_CLOUDFLARED_DIGEST=sha256:REPLACE
ANNOLUX_TUNNEL_TOKEN=
ANNOLUX_ACCOUNTS_DIR=./accounts
ANNOLUX_INDEX_FILE=./data/index.db
ANNOLUX_API_BIND_PORT=8083
ANNOLUX_WEB_BIND_PORT=8084
ANNOLUX_CONTAINER_UID=65532
ANNOLUX_CONTAINER_GID=65532

# Operator-only backups. Password lives in the environment, never in scripts.
ANNOLUX_RESTIC_REPOSITORY=s3:https://REPLACE.r2.cloudflarestorage.com/annolux-backups
ANNOLUX_RESTIC_PASSWORD=
ANNOLUX_R2_ACCESS_KEY_ID=
ANNOLUX_R2_SECRET_ACCESS_KEY=

# External job heartbeats. Values are HTTPS URLs from the monitoring account.
ANNOLUX_HEARTBEAT_BACKUP_URL=
ANNOLUX_HEARTBEAT_RECONCILE_URL=
ANNOLUX_HEARTBEAT_REFRESH_URL=
